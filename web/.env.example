# GitHub Personal Access Token (fine-grained)
# Required for bug report form to create GitHub issues
# Needs: issues:write permission on theroadeldorado/golf-cam-replay
GITHUB_TOKEN=your_github_token_here

# Google Analytics 4 Measurement ID
# Get this from https://analytics.google.com → Admin → Data Streams → your stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Upstash Redis — backs the phone-camera WebRTC signaling relay (/api/signal).
# Required in production; local dev falls back to an in-memory store if unset.
# Provision a database at https://console.upstash.com (or `vercel env pull` if
# the Upstash integration is installed on the Vercel project).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
