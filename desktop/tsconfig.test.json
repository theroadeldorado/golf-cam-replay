{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "tests/unit/**/*.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/capture/*.ts",
    "src/renderer/src/cameras/*.ts",
    "src/preload/api.d.ts"
  ]
}
